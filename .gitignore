# BASt data. The rebuilt layout for 2018, 2022 and 2023 and the cleaned
# station list are tracked (Datenlizenz Deutschland – Namensnennung 2.0,
# see DATA_LICENSE.md). Raw downloads, zips and any other year or station
# list stay out of git. To track a year you add later (e.g. 2019), add a
# line "!/2019/" below.
/[0-9][0-9][0-9][0-9]/
!/2018/
!/2019/
!/2022/
!/2023/
/raw_data/
/Jawe*.csv
!/Jawe2023.csv
/*.csv
!/Jawe2023.csv
*.zip
# Small reference file that belongs to the code (station number -> name)
!/station_names.csv
